<Window x:Class="Sliders.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Sliders.Converters"
        xmlns:vm="clr-namespace:Sliders.ViewModels"
        Title="Sliders"
        Height="490"
        MinHeight="490"
        MaxHeight="490"
        SizeToContent="Width"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        Icon="pack://application:,,,/Sliders;component/icon.png"
        Background="{StaticResource BgDeepBrush}"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" 
                      ResizeBorderThickness="6" 
                      GlassFrameThickness="1" 
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrush"/>
        <conv:ValueToWidthConverter x:Key="ValueToWidth"/>
        <conv:ValueToBarBrushConverter x:Key="ValueToBarBrush"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibility"/>
        <conv:BoolToActiveTextConverter x:Key="BoolToActiveText"/>

        <!-- Channel Strip Card Border Style -->
        <Style x:Key="ChannelStripBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Width" Value="106"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BorderFocusBrush}"/>
                    <Setter Property="Background" Value="#FF242429"/> <!-- Flat graphite hover highlight -->
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Status Dot Style (No glow, flat professional indicator) -->
        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                    <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Slider row template (Redesigned as vertical Channel Strips) -->
        <DataTemplate x:Key="SliderCardTemplate" DataType="{x:Type vm:SliderViewModel}">
            <Border Style="{StaticResource ChannelStripBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Top Header: Navigation and Index Badge -->
                        <RowDefinition Height="Auto"/>
                        <!-- Target Selection -->
                        <RowDefinition Height="Auto"/>
                        <!-- Fader Scale & Level Meter -->
                        <RowDefinition Height="*"/>
                        <!-- Value Percent -->
                        <RowDefinition Height="Auto"/>
                        <!-- Controls (Invert Toggle) -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top header: CH Label and Move buttons -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Move Left -->
                        <Button Grid.Column="0" Style="{StaticResource IconButton}"
                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="Move left"
                                Width="20" Height="20">
                            <Path Data="M 4.5,1 L 1,4.5 L 4.5,8" 
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                  StrokeThickness="1.5" 
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="4" Height="7" 
                                  Stretch="Uniform"/>
                        </Button>

                        <!-- Index Label -->
                        <Border Grid.Column="1" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center"
                                Padding="5,2" 
                                CornerRadius="4" 
                                Background="{StaticResource AccentBadgeBrush}">
                            <TextBlock Text="{Binding SliderIndex, StringFormat='CH {0}'}" 
                                       Foreground="{StaticResource AccentBrush}" 
                                       FontFamily="Segoe UI" 
                                       FontSize="10" 
                                       FontWeight="Bold"/>
                        </Border>

                        <!-- Move Right -->
                        <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="Move right"
                                Width="20" Height="20">
                            <Path Data="M 1.5,1 L 5,4.5 L 1.5,8" 
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                  StrokeThickness="1.5" 
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="4" Height="7" 
                                  Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <!-- Target Application Selector (Compact ComboBox) -->
                    <ComboBox Grid.Row="1" 
                              Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding AvailableTargets}"
                              SelectedItem="{Binding MappedTarget, Mode=TwoWay}"
                              Width="90"
                              MinHeight="28"
                              Margin="0,0,0,4"
                              HorizontalAlignment="Center"/>

                     <!-- Vertical Level Meter & Fader Ticks -->
                    <Grid Grid.Row="2" Height="230" Margin="0,0,0,8" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Tick Scale Marks (11 Marks, spaced for 230 height) -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Stretch" HorizontalAlignment="Right" Margin="0,4">
                            <Border Width="5" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,21"/>
                            <Border Width="5" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,21"/>
                            <Border Width="5" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,21"/>
                            <Border Width="5" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,21"/>
                            <Border Width="5" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,21"/>
                            <Border Width="5" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,21"/>
                            <Border Width="5" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,21"/>
                            <Border Width="5" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,21"/>
                            <Border Width="5" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,21"/>
                            <Border Width="5" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,21"/>
                            <Border Width="5" Height="1" Background="{StaticResource BorderBrush}"/>
                        </StackPanel>

                        <!-- Vertical Level Progress Bar -->
                        <ProgressBar Grid.Column="1" 
                                     Orientation="Vertical"
                                     Style="{StaticResource VerticalProgressBar}"
                                     Minimum="0" Maximum="1"
                                     Value="{Binding CurrentValue, Mode=OneWay}"
                                     Width="8" Height="230"
                                     Margin="4,0"/>

                        <!-- Right Tick Scale Marks (11 Marks, spaced for 230 height) -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Stretch" HorizontalAlignment="Left" Margin="0,4">
                            <Border Width="5" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,21"/>
                            <Border Width="5" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,21"/>
                            <Border Width="5" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,21"/>
                            <Border Width="5" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,21"/>
                            <Border Width="5" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,21"/>
                            <Border Width="5" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,21"/>
                            <Border Width="5" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,21"/>
                            <Border Width="5" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,21"/>
                            <Border Width="5" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,21"/>
                            <Border Width="5" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,21"/>
                            <Border Width="5" Height="1" Background="{StaticResource BorderBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Volume Percentage -->
                    <TextBlock Grid.Row="3"
                               Text="{Binding CurrentValuePercent}"
                               Foreground="{StaticResource TextSecBrush}"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <!-- Invert Toggle (Clean Toggle Button style CheckBox) -->
                    <CheckBox Grid.Row="4"
                              Style="{StaticResource ToggleCheckBox}"
                              IsChecked="{Binding IsInverted, Mode=TwoWay}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Custom Title Bar Row -->
            <RowDefinition Height="32"/>
            <!-- Main Content Row -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <!-- Left Sidebar for Settings & Connection -->
            <ColumnDefinition Width="220"/>
            <!-- Right Workspace for Fader Deck -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- CUSTOM TITLE BAR (LEFT) -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="{StaticResource BgDeepBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False">
                    <Grid Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Border Width="1.5" Height="6" CornerRadius="0.5" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" Margin="0.5,0,0,0"/>
                        <Border Width="1.5" Height="9.5" CornerRadius="0.5" Background="{StaticResource AccentSecBrush}" HorizontalAlignment="Center"/>
                        <Border Width="1.5" Height="4.5" CornerRadius="0.5" Background="{StaticResource AccentBrush}" HorizontalAlignment="Right" Margin="0,0,0.5,0"/>
                    </Grid>
                    <TextBlock Text="SLIDERS" 
                               Foreground="{StaticResource TextBrush}" 
                               FontFamily="Segoe UI" 
                               FontSize="9.5" 
                               FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CUSTOM TITLE BAR (RIGHT) -->
        <Border Grid.Row="0" Grid.Column="1"
                Background="{StaticResource BgDeepBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="Transparent"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource IconButton}" 
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimize"
                            Width="28" Height="24"
                            Margin="0,0,4,0">
                        <Path Data="M 2,6 L 10,6" 
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                              StrokeThickness="1.5" 
                              Width="8" Height="8" 
                              Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" 
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"
                            ToolTip="Close"
                            Width="28" Height="24">
                        <Path Data="M 2,2 L 10,10 M 10,2 L 2,10" 
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                              StrokeThickness="1.5" 
                              Width="8" Height="8" 
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Row="1" Grid.Column="0" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0,0,1,0" 
                Background="{StaticResource BgDeepBrush}">
            <Grid Margin="16,12,16,12">
                <Grid.RowDefinitions>
                    <!-- Scrollable Settings area -->
                    <RowDefinition Height="*"/>
                    <!-- Status display at bottom -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Scrollable Settings panels -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- Connection Section -->
                        <Grid Height="32" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource SectionHeader}" 
                                       Text="CONNECTION" 
                                       VerticalAlignment="Center"
                                       Margin="0"/>
                        </Grid>
                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- Port field -->
                                <TextBlock Style="{StaticResource LabelText}" Text="Serial Port" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" Style="{StaticResource DarkComboBox}"
                                              ItemsSource="{Binding AvailablePorts}"
                                              SelectedItem="{Binding SelectedPort, Mode=TwoWay}"
                                              MinHeight="28"/>
                                    <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                            Command="{Binding RefreshPortsCommand}"
                                            ToolTip="Refresh ports"
                                            Margin="6,0,0,0">
                                        <Path Data="M 1,5 A 4,4 0 1,1 2,8 M 2,3 L 2,6 L 5,6" 
                                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                              StrokeThickness="1.5" 
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              VerticalAlignment="Center" 
                                              Width="11" Height="11" 
                                              Stretch="Uniform"/>
                                    </Button>
                                </Grid>

                                <!-- Baud rate field -->
                                <TextBlock Style="{StaticResource LabelText}" Text="Baud Rate" Margin="0,0,0,4"/>
                                <ComboBox Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding AvailableBaudRates}"
                                          SelectedItem="{Binding SelectedBaudRate, Mode=TwoWay}"
                                          MinHeight="28"
                                          Margin="0,0,0,8"/>

                                <!-- Connect actions -->
                                <Button Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ConnectCommand}"
                                        Visibility="{Binding IsConnected, Converter={StaticResource InvertedBoolToVisibility}}"
                                        Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 2,1 L 8,5 L 2,9 Z" 
                                              Fill="#FF0C0A0A" 
                                              VerticalAlignment="Center" 
                                              Margin="0,0,6,0" 
                                              Width="8" Height="8" 
                                              Stretch="Uniform"/>
                                        <TextBlock Text="Connect Deck" VerticalAlignment="Center" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DangerButton}"
                                        Command="{Binding DisconnectCommand}"
                                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}"
                                        Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 1,1 L 9,9 M 9,1 L 1,9" 
                                              Stroke="#FF0C0A0A" 
                                              StrokeThickness="2" 
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              VerticalAlignment="Center" 
                                              Margin="0,0,6,0" 
                                              Width="8" Height="8" 
                                              Stretch="Uniform"/>
                                        <TextBlock Text="Disconnect" VerticalAlignment="Center" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Preferences Section -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="PREFERENCES" Margin="0,4,0,6"/>
                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox Style="{StaticResource DarkCheckBox}"
                                          IsChecked="{Binding LaunchOnStartup, Mode=TwoWay}"
                                          Content="Launch on startup"
                                          Margin="0,0,0,8"/>
                                <CheckBox Style="{StaticResource DarkCheckBox}"
                                          IsChecked="{Binding LaunchMinimized, Mode=TwoWay}"
                                          Content="Start minimized"
                                          Margin="0,0,0,8"/>
                                <CheckBox Style="{StaticResource DarkCheckBox}"
                                          IsChecked="{Binding AutoConnect, Mode=TwoWay}"
                                          Content="Auto-connect"
                                          Margin="0,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Save Configuration Button -->
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveConfigCommand}"
                                Padding="12,8"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 1,5 L 4,8 L 9,2" 
                                      Stroke="#FF0C0A0A" 
                                      StrokeThickness="2" 
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Margin="0,0,6,0" 
                                      VerticalAlignment="Center" 
                                      Width="10" Height="8" 
                                      Stretch="Uniform"/>
                                <TextBlock Text="Save Settings" VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Status indicators at very bottom of Sidebar (GitHub Link) -->
                <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <TextBlock FontFamily="Segoe UI"
                               FontSize="10"
                               FontWeight="Medium"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center">
                        <TextBlock.Resources>
                            <Style TargetType="Hyperlink">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                <Setter Property="TextDecorations" Value="None"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Resources>
                        <Hyperlink NavigateUri="https://github.com/anastvogia" 
                                   RequestNavigate="Hyperlink_RequestNavigate">
                            github.com/anastvogia
                        </Hyperlink>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT WORKSPACE (Fader Mixing Board) -->
        <Grid Grid.Row="1" Grid.Column="1" Background="Transparent" Margin="20,12,20,16">
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Vertical fader cards container -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Main Workspace Header -->
            <Grid Grid.Row="0" Height="32" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="VOLUME MIXING DECK" 
                           Foreground="{StaticResource TextSecBrush}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <!-- Refresh Apps Button -->
                <Button Grid.Column="1"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding RefreshProcessesCommand}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 1,5 A 4,4 0 1,1 2,8 M 2,3 L 2,6 L 5,6" 
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                              StrokeThickness="1.5" 
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Margin="0,0,6,0" 
                              VerticalAlignment="Center" 
                              Width="10" Height="10" 
                              Stretch="Uniform"/>
                        <TextBlock Text="Refresh Apps" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Horizontal Mixing Board Area (Scaling Window size) -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Disabled" 
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding Sliders}"
                              ItemTemplate="{StaticResource SliderCardTemplate}"
                              VerticalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
